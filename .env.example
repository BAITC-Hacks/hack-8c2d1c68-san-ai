# Leave empty for local single-process PostgreSQL (PGlite).
DATABASE_URL=
PGLITE_DATA_DIR=.data/pglite
DOCUMENT_STORAGE_DIR=.data/documents
OPENAI_API_KEY=
OPENAI_EXTRACTION_MODEL=gpt-4.1-mini
OPENAI_COMPARISON_MODEL=gpt-6-sol
# Legacy OPENAI_MODEL is used only as an extraction fallback.
# Alternative: postgresql://san:local_demo_only@127.0.0.1:5432/san
